Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
    RewriteRule ^bootstrap/ - [F,L]
    RewriteRule ^importer/ - [F,L]
</IfModule>

<FilesMatch "\.(sql|md|log|ini|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
